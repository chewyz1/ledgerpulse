#!/usr/bin/env bash
set -e
APP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ledgerpulse-app-v2.0"
mkdir -p "$APP_CACHE"
if [ ! -f "$APP_CACHE/LedgerPulse-2.0-linux-x64/start-ledgerpulse.sh" ]; then
  echo "Extracting LedgerPulse v2.0..."
  tail -n +14 "$0" | base64 -d | tar -xzf - -C "$APP_CACHE"
fi
exec "$APP_CACHE/LedgerPulse-2.0-linux-x64/start-ledgerpulse.sh" "$@"
exit 0

