#!/usr/bin/env bash
set -e
APP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ledgerpulse-app-v3.0"
rm -rf "$APP_CACHE/LedgerPulse-3.0-linux-x64"
mkdir -p "$APP_CACHE"
echo "Extracting LedgerPulse v3.0..."
sed '1,/^__ARCHIVE_BELOW__$/d' "$0" | base64 -d | tar -xzf - -C "$APP_CACHE"
exec "$APP_CACHE/LedgerPulse-3.0-linux-x64/start-ledgerpulse.sh" "$@"
exit 0
__ARCHIVE_BELOW__

